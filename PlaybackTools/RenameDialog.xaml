<Window x:Class="PlaybackTools.RenameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rename" Height="170" Width="360" WindowStartupLocation="CenterOwner"
        Background="#FF1E1E1E" ResizeMode="NoResize">
    <StackPanel Margin="15">
        <TextBlock Text="New name:" Foreground="White" Margin="0,0,0,6"/>
        <TextBox x:Name="NameTextBox" Padding="4" MaxLength="40"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Cancel" Width="80" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="OK" Width="80" IsDefault="True" Click="OkButton_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
