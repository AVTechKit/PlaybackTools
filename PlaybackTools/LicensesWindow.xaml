<Window x:Class="PlaybackTools.LicensesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quick Start Guide" Height="600" Width="560" WindowStartupLocation="CenterOwner"
        Background="#FF1E1E1E" ResizeMode="CanResizeWithGrip">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ContentPanel"/>
        </ScrollViewer>

        <Button Grid.Row="1" Content="Close" Width="90" HorizontalAlignment="Right" Margin="0,12,0,0"
                Background="#FF2A2A2A" Foreground="White" BorderBrush="#FF3A3A3A" Padding="8,6"
                IsCancel="True" Click="CloseButton_Click"/>
    </Grid>
</Window>