<Window x:Class="PlaybackTools.BackgroundImageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Background Image" Height="280" Width="623" WindowStartupLocation="CenterOwner"
        Background="#FF1E1E1E" ResizeMode="NoResize">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,15,0">
                <Button Content="Load Background Image" Click="LoadButton_Click" Margin="0,0,0,8"
                        Background="#FF2A2A2A" Foreground="White" BorderBrush="#FF3A3A3A" Padding="8,6"/>
                <Button Content="Remove Background Image" Click="RemoveButton_Click" Margin="0,0,0,20"
                        Background="#FF2A2A2A" Foreground="White" BorderBrush="#FF3A3A3A" Padding="8,6"/>

                <CheckBox Content="Apply Background Image to STOP" Foreground="White" Margin="0,0,0,10"
                          IsChecked="{Binding ShowBackgroundOnStop}" Height="20" Width="204"/>
                <CheckBox Content="Apply Background Image to Audio Files" Foreground="White"
                          IsChecked="{Binding ShowBackgroundOnAudio}"/>
            </StackPanel>

            <Viewbox Grid.Column="1" Stretch="Uniform">
                <Border Width="320" Height="180" Background="Black" BorderBrush="#FF3A3A3A" BorderThickness="1">
                    <Image x:Name="PreviewImage" Stretch="Uniform"/>
                </Border>
            </Viewbox>
        </Grid>

        <Button Grid.Row="1" Content="Close" Width="90" HorizontalAlignment="Right" Margin="0,15,0,0"
                Background="#FF2A2A2A" Foreground="White" BorderBrush="#FF3A3A3A" Padding="8,6" Click="CloseButton_Click"/>
    </Grid>
</Window>