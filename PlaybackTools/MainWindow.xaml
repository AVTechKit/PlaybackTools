<Window x:Class="PlaybackTools.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PlaybackTools.ViewModels"
        Title="Playback Tools - Control Window" Height="1000" Width="1920"
        Background="#FF141414" WindowStartupLocation="Manual" Left="0" Top="0" KeyDown="Window_KeyDown"
        Icon="/Assets/PlaybackIcon.ico">
    
    <Window.Resources>
        <Style x:Key="PageTabStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="ContextMenu">
                <Setter.Value>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="Rename Page" Command="{Binding RenameCommand}"/>
                        <MenuItem Header="Restore Default Name" Command="{Binding RestoreDefaultNameCommand}"/>
                        <Separator/>
                        <MenuItem Header="Set Page Color">
                            <MenuItem Header="Choose Color..." Command="{Binding ChooseColorCommand}"/>
                            <MenuItem Header="Reset to Default" Command="{Binding ResetColorCommand}"/>
                        </MenuItem>
                    </ContextMenu>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="#FF1E1E1E" BorderBrush="{Binding BorderBrush}" BorderThickness="2" Padding="4">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF1E5F8A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ClipButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF2A2A2A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF3A3A3A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF3A9EDB"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="4"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF3A3A3A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <vm:EndActionEqualsConverter x:Key="EndActionEqualsConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <vm:EndActionToVisibilityConverter x:Key="EndActionToVisibilityConverter"/>
        <vm:NonDefaultTimeToVisibilityConverter x:Key="NonDefaultTimeToVisibilityConverter"/>
        <vm:TimeToShortLabelConverter x:Key="TimeToShortLabelConverter"/>

        <!-- Custom scrub bar look: thin dark track, accent-colored fill up to the
             thumb, small round handle - built via the standard Slider Track parts
             so click-to-jump and drag both keep working, just restyled. -->
        <Style x:Key="ScrubTransparentRepeatButtonStyle" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Rectangle Fill="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrubFillRepeatButtonStyle" TargetType="RepeatButton" BasedOn="{StaticResource ScrubTransparentRepeatButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="#FF3A9EDB" CornerRadius="3" Height="6" VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrubThumbStyle" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Ellipse Fill="White" Stroke="#FF3A9EDB" StrokeThickness="1.5"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrubBarStyle" TargetType="Slider">
            <Setter Property="Height" Value="20"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="6" CornerRadius="3" Background="#FF3A3A3A" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource ScrubFillRepeatButtonStyle}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource ScrubTransparentRepeatButtonStyle}"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrubThumbStyle}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>   <!-- Control Section -->
            <RowDefinition Height="0.3*"/> <!-- Waveform strip placeholder -->
            <RowDefinition Height="0.1*"/> <!-- Page tabs -->
            <RowDefinition Height="1.5*"/> <!-- Clip grid -->
        </Grid.RowDefinitions>

        <!-- CONTROL SECTION -->
        <Grid Grid.Row="0" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1.3*"/>
                <ColumnDefinition Width="1.2*"/>
            </Grid.ColumnDefinitions>

            <!-- INFO SECTION -->
            <StackPanel Grid.Column="0" Margin="10">
                <TextBlock Text="{Binding ClipName}" Foreground="White" FontSize="22" FontWeight="Bold"/>
                <TextBlock x:Name="DurationTextBlock" Text="{Binding Duration, StringFormat='Duration: {0}'}" Foreground="#FFAAAAAA" FontSize="20" Margin="0,4,0,0"/>
                <TextBlock Text="{Binding EndActionDisplay, StringFormat='End Action: {0}'}" Foreground="#FFAAAAAA" FontSize="20" Margin="0,4,0,10"/>
                <TextBlock Text="{Binding TimeRemaining, StringFormat='Remaining: {0}'}" Foreground="White" FontSize="28" FontWeight="Bold"/>

                <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                    <Button Content="&#9654;" Width="70" Height="45" Margin="0,0,6,0" Background="#FF2E7D32" Foreground="White" Command="{Binding PlayCommand}"/>
                    <Button Content="&#10074;&#10074;" Width="70" Height="45" Margin="0,0,6,0" Background="#FF9E8B00" Foreground="White" Command="{Binding PauseCommand}"/>
                    <Button Content="&#9632;" Width="70" Height="45" Background="#FF8B0000" Foreground="White" Command="{Binding StopCommand}"/>
                </StackPanel>
            </StackPanel>

            <!-- NAVIGATION SECTION -->
            <StackPanel Grid.Column="1" Margin="10">
                <TextBlock Text="Volume:" Foreground="White"/>
                <DockPanel>
                    <TextBlock Text="{Binding Volume, StringFormat={}{0:0}}" Foreground="White" DockPanel.Dock="Right" Width="40"/>
                    <Slider Minimum="0" Maximum="100" Value="{Binding Volume}"/>
                </DockPanel>

                <TextBlock Text="Fade Time:" Foreground="White" Margin="0,10,0,0"/>
                <DockPanel>
                    <TextBlock Text="{Binding FadeTime, StringFormat={}{0:0.0}s}" Foreground="White" DockPanel.Dock="Right" Width="40"/>
                    <Slider Minimum="0" Maximum="5" Value="{Binding FadeTime}"/>
                </DockPanel>

                <TextBlock Text="In / Out Points:" Foreground="White" Margin="0,15,0,4"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <TextBox Grid.Row="0" Grid.Column="0" Text="{Binding ActiveSlot.InPoint}" Grid.ColumnSpan="2" Margin="0,0,3,3"/>
                    <TextBox Grid.Row="0" Grid.Column="2" Text="{Binding ActiveSlot.OutPoint}" Grid.ColumnSpan="2" Margin="3,0,0,3"/>
                    <Button Grid.Row="1" Grid.Column="0" Content="Mark In" Margin="3,3,3,3" Command="{Binding MarkInCommand}"/>
                    <Button Grid.Row="1" Grid.Column="3" Content="Mark Out" Margin="3,3,3,3" Command="{Binding MarkOutCommand}"/>
                    <Button Grid.Row="1" Grid.Column="1" Content="Reset In" Margin="3,3,3,3" Click="ResetInButton_Click"/>
                    <Button Grid.Row="1" Grid.Column="2" Content="Reset Out" Margin="3,3,3,3" Click="ResetOutButton_Click"/>
                </Grid>

                <Grid Margin="0,15,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Button Grid.Row="0" Grid.Column="0" Content="Skip to Start" Margin="2" Click="SkipToStartButton_Click"/>
                    <Button Grid.Row="0" Grid.Column="1" Content="Skip to End" Margin="2" Click="SkipToEndButton_Click"/>
                    <Button Grid.Row="0" Grid.Column="2" Content="Last 15" Margin="2" Click="Last15Button_Click"/>
                    <Button Grid.Row="1" Grid.Column="0" Content="Skip Backward" Margin="2" Click="SkipBackwardButton_Click"/>
                    <Button Grid.Row="1" Grid.Column="1" Content="Skip Forward" Margin="2" Click="SkipForwardButton_Click"/>
                    <Button Grid.Row="1" Grid.Column="2" Content="Last 30" Margin="2" Click="Last30Button_Click"/>
                </Grid>
            </StackPanel>

            <!-- PREVIEW SECTION -->
            <Grid Grid.Column="2" Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="44"/>
                </Grid.ColumnDefinitions>

                <!-- Placeholder for the real GLWpfControl preview surface, wired in a later pass.
                     Viewbox locks this to a true 16:9 shape regardless of the cell's actual
                     proportions - may letterbox (empty space top/bottom or sides) rather than
                     stretch, which is correct behavior, not a bug. -->
                <Viewbox Grid.Row="0" Grid.Column="0" Stretch="Uniform">
                    <Grid Width="1920" Height="1080" Background="Black">
                        <Image x:Name="PreviewImage" Stretch="Uniform"/>
                    </Grid>
                </Viewbox>

                <!-- VU METERS -->
                <Grid Grid.Row="0" Grid.Column="1" Margin="4,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <!-- Left channel -->
                    <Grid Grid.Column="0" Margin="2,0">
                        <Border Background="#FF2A2A2A" CornerRadius="2"/>
                        <Border CornerRadius="2">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                    <GradientStop Color="#FF3DD66B" Offset="0"/>
                                    <GradientStop Color="#FF3DD66B" Offset="0.55"/>
                                    <GradientStop Color="#FFE8C93A" Offset="0.75"/>
                                    <GradientStop Color="#FFE8564A" Offset="0.92"/>
                                    <GradientStop Color="#FFE8564A" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border x:Name="VuLeftMask" Background="#FF2A2A2A" CornerRadius="2"
                                RenderTransformOrigin="0.5,0">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="VuLeftMaskScale" ScaleY="1"/>
                            </Border.RenderTransform>
                        </Border>
                    </Grid>

                    <!-- Right channel -->
                    <Grid Grid.Column="1" Margin="2,0">
                        <Border Background="#FF2A2A2A" CornerRadius="2"/>
                        <Border CornerRadius="2">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                    <GradientStop Color="#FF3DD66B" Offset="0"/>
                                    <GradientStop Color="#FF3DD66B" Offset="0.55"/>
                                    <GradientStop Color="#FFE8C93A" Offset="0.75"/>
                                    <GradientStop Color="#FFE8564A" Offset="0.92"/>
                                    <GradientStop Color="#FFE8564A" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border x:Name="VuRightMask" Background="#FF2A2A2A" CornerRadius="2"
                                RenderTransformOrigin="0.5,0">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="VuRightMaskScale" ScaleY="1"/>
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                </Grid>

                <Slider x:Name="ScrubSlider" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                        Style="{StaticResource ScrubBarStyle}"
                        Minimum="0" Maximum="100" Value="{Binding ScrubPosition}" Margin="0,6,0,0"
                        PreviewMouseLeftButtonDown="ScrubSlider_PreviewMouseLeftButtonDown"
                        PreviewMouseLeftButtonUp="ScrubSlider_PreviewMouseLeftButtonUp"
                        ValueChanged="ScrubSlider_ValueChanged"/>

                <Popup x:Name="ScrubTooltipPopup" PlacementTarget="{Binding ElementName=ScrubSlider}"
                       Placement="Mouse" AllowsTransparency="True" IsOpen="False">
                    <Border Background="#FF1E1E1E" BorderBrush="#FF3A9EDB" BorderThickness="1" CornerRadius="4" Padding="6,3">
                        <TextBlock x:Name="ScrubTooltipText" Foreground="White" FontSize="12"/>
                    </Border>
                </Popup>
            </Grid>
        </Grid>

        <!-- SETTINGS BUTTON - floats top-right, above the whole Control Section -->
        <Button Grid.Row="0" Content="&#9881;" FontSize="20" Width="34" Height="34" Margin="0,10,14,0"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Background="Transparent" Foreground="White" BorderThickness="0"
                Click="SettingsButton_Click"/>

        <!-- WAVEFORM VIEW / second scrub bar -->
        <Grid x:Name="WaveformContainer" Grid.Row="1" Margin="10,0" ClipToBounds="True"
              SizeChanged="WaveformContainer_SizeChanged"
              PreviewMouseLeftButtonDown="WaveformContainer_PreviewMouseLeftButtonDown"
              PreviewMouseMove="WaveformContainer_PreviewMouseMove"
              PreviewMouseLeftButtonUp="WaveformContainer_PreviewMouseLeftButtonUp">
            <Border Background="#FF1A1A1A" BorderBrush="#FF333333" BorderThickness="0,1,0,1"/>
            <Polygon x:Name="WaveformPolygon" Fill="#FF3A9EDB"/>
            <Line x:Name="WaveformCursor" Stroke="White" StrokeThickness="2" Visibility="Collapsed"/>
        </Grid>

        <!-- PAGE TABS -->
        <ListBox Grid.Row="2" ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}"
                 ItemContainerStyle="{StaticResource PageTabStyle}" BorderThickness="0" Background="Transparent">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="10"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding PageName}" Foreground="White">
                        <TextBlock.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="Rename Page" Command="{Binding RenameCommand}"/>
                                <MenuItem Header="Restore Default Name" Command="{Binding RestoreDefaultNameCommand}"/>
                                <Separator/>
                                <MenuItem Header="Set Page Color">
                                    <MenuItem Header="Choose Color..." Command="{Binding ChooseColorCommand}"/>
                                    <MenuItem Header="Reset to Default" Command="{Binding ResetColorCommand}"/>
                                </MenuItem>
                            </ContextMenu>
                        </TextBlock.ContextMenu>
                    </TextBlock>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- CLIP GRID -->
        <ItemsControl Grid.Row="3" ItemsSource="{Binding SelectedPage.Slots}" Margin="10">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="6"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Style="{StaticResource ClipButtonStyle}"
                            Command="{Binding DataContext.ClipClickCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"
                            AllowDrop="True" DragEnter="ClipButton_DragEnter" Drop="ClipButton_Drop">
                        <Button.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="Add Clip" Command="{Binding ReplaceCommand}"
                                          Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"/>

                                <MenuItem Header="Rename Clip" Command="{Binding RenameCommand}"
                                          Visibility="{Binding IsLoaded, Converter={StaticResource BoolToVis}}"/>
                                <MenuItem Header="Move/Swap Clip" Command="{Binding MoveSwapCommand}"
                                          Visibility="{Binding IsLoaded, Converter={StaticResource BoolToVis}}"/>
                                <MenuItem Header="Replace Clip" Command="{Binding ReplaceCommand}"
                                          Visibility="{Binding IsLoaded, Converter={StaticResource BoolToVis}}"/>
                                <MenuItem Header="Set Button Color" Visibility="{Binding IsLoaded, Converter={StaticResource BoolToVis}}">
                                    <MenuItem Header="Choose Color..." Command="{Binding ChooseColorCommand}"/>
                                    <MenuItem Header="Reset to Default" Command="{Binding ResetColorCommand}"/>
                                </MenuItem>
                                <MenuItem Header="Set End Action" Visibility="{Binding IsLoaded, Converter={StaticResource BoolToVis}}">
                                    <MenuItem Header="Loop (Cut)" IsCheckable="True"
                                              IsChecked="{Binding EndAction, Converter={StaticResource EndActionEqualsConverter}, ConverterParameter={x:Static vm:EndAction.LoopCut}, Mode=OneWay}"
                                              Command="{Binding SetEndActionCommand}" CommandParameter="{x:Static vm:EndAction.LoopCut}"/>
                                    <MenuItem Header="Loop (Fade)" IsCheckable="True"
                                              IsChecked="{Binding EndAction, Converter={StaticResource EndActionEqualsConverter}, ConverterParameter={x:Static vm:EndAction.LoopFade}, Mode=OneWay}"
                                              Command="{Binding SetEndActionCommand}" CommandParameter="{x:Static vm:EndAction.LoopFade}"/>
                                    <MenuItem Header="Play Next" IsCheckable="True"
                                              IsChecked="{Binding EndAction, Converter={StaticResource EndActionEqualsConverter}, ConverterParameter={x:Static vm:EndAction.PlayNext}, Mode=OneWay}"
                                              Command="{Binding SetEndActionCommand}" CommandParameter="{x:Static vm:EndAction.PlayNext}"/>
                                    <MenuItem Header="Play Selected Clip..." IsCheckable="True"
                                              IsChecked="{Binding EndAction, Converter={StaticResource EndActionEqualsConverter}, ConverterParameter={x:Static vm:EndAction.PlaySelected}, Mode=OneWay}"
                                              Command="{Binding PlaySelectedCommand}"/>
                                    <MenuItem Header="Pause on Last Frame" IsCheckable="True"
                                              IsChecked="{Binding EndAction, Converter={StaticResource EndActionEqualsConverter}, ConverterParameter={x:Static vm:EndAction.PauseOnLastFrame}, Mode=OneWay}"
                                              Command="{Binding SetEndActionCommand}" CommandParameter="{x:Static vm:EndAction.PauseOnLastFrame}"/>
                                    <MenuItem Header="Stop to Black" IsCheckable="True"
                                              IsChecked="{Binding EndAction, Converter={StaticResource EndActionEqualsConverter}, ConverterParameter={x:Static vm:EndAction.StopToBlack}, Mode=OneWay}"
                                              Command="{Binding SetEndActionCommand}" CommandParameter="{x:Static vm:EndAction.StopToBlack}"/>
                                </MenuItem>
                                <Separator Visibility="{Binding IsLoaded, Converter={StaticResource BoolToVis}}"/>
                                <MenuItem Header="Remove Clip" Command="{Binding RemoveCommand}"
                                          Visibility="{Binding IsLoaded, Converter={StaticResource BoolToVis}}"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                        <Grid>
                                <DockPanel>
                                    <Rectangle DockPanel.Dock="Left" Width="6" Fill="{Binding ColorStripBrush}"/>
                                    <TextBlock Text="{Binding DisplayName}" Foreground="White" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </DockPanel>

                                <Grid Visibility="{Binding IsLoaded, Converter={StaticResource BoolToVis}}">
                                    <!-- END ACTION ICON - top right. Exactly one of these six is
                                     ever visible, since EndAction is always a single value. -->
                                    <Canvas Width="14" Height="14" Margin="0,4,4,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Visibility="{Binding EndAction, Converter={StaticResource EndActionToVisibilityConverter}, ConverterParameter={x:Static vm:EndAction.LoopCut}}">
                                        <Path Data="M 10,3 A 5,5 0 1 1 7,2" Stroke="White" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        <Polygon Points="10,3 12.5,2 11.5,5" Fill="White"/>
                                    </Canvas>
                                    <Canvas Width="14" Height="14" Margin="0,4,4,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Visibility="{Binding EndAction, Converter={StaticResource EndActionToVisibilityConverter}, ConverterParameter={x:Static vm:EndAction.LoopFade}}">
                                        <Path Data="M 10,3 A 5,5 0 1 1 7,2" Stroke="White" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        <Polygon Points="10,3 12.5,2 11.5,5" Fill="White"/>
                                    </Canvas>
                                    <Canvas Width="14" Height="14" Margin="0,4,4,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Visibility="{Binding EndAction, Converter={StaticResource EndActionToVisibilityConverter}, ConverterParameter={x:Static vm:EndAction.PauseOnLastFrame}}">
                                        <Rectangle Width="2" Height="9" Fill="White" Canvas.Left="4" Canvas.Top="2.5"/>
                                        <Rectangle Width="2" Height="9" Fill="White" Canvas.Left="8" Canvas.Top="2.5"/>
                                    </Canvas>
                                    <Canvas Width="14" Height="14" Margin="0,4,4,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Visibility="{Binding EndAction, Converter={StaticResource EndActionToVisibilityConverter}, ConverterParameter={x:Static vm:EndAction.StopToBlack}}">
                                        <Rectangle Width="8" Height="8" Fill="White" Canvas.Left="3" Canvas.Top="3"/>
                                    </Canvas>
                                    <Canvas Width="14" Height="14" Margin="0,4,4,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Visibility="{Binding EndAction, Converter={StaticResource EndActionToVisibilityConverter}, ConverterParameter={x:Static vm:EndAction.PlayNext}}">
                                        <Polygon Points="3,2 3,12 12,7" Fill="White"/>
                                    </Canvas>
                                    <Canvas Width="14" Height="14" Margin="0,4,4,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Visibility="{Binding EndAction, Converter={StaticResource EndActionToVisibilityConverter}, ConverterParameter={x:Static vm:EndAction.PlaySelected}}">
                                        <Polygon Points="1,2 1,12 7,7" Fill="White"/>
                                        <Line X1="9" Y1="3" X2="13" Y2="11" Stroke="White" StrokeThickness="1.5"/>
                                        <Line X1="13" Y1="3" X2="9" Y2="11" Stroke="White" StrokeThickness="1.5"/>
                                    </Canvas>

                                    <!-- MARK IN FLAG - bottom left -->
                                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12,0,0,2" Orientation="Horizontal"
                                            Visibility="{Binding InPoint, Converter={StaticResource NonDefaultTimeToVisibilityConverter}}">
                                        <Polygon Points="0,0 6,0 3,6" Fill="#FF3DD66B"/>
                                        <TextBlock Text="{Binding InPoint, Converter={StaticResource TimeToShortLabelConverter}}"
                                               Foreground="#FF3DD66B" FontSize="9" Margin="3,0,0,0"/>
                                    </StackPanel>

                                    <!-- MARK OUT FLAG - bottom right -->
                                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,3,2" Orientation="Horizontal"
                                            Visibility="{Binding OutPoint, Converter={StaticResource NonDefaultTimeToVisibilityConverter}}">
                                        <TextBlock Text="{Binding OutPoint, Converter={StaticResource TimeToShortLabelConverter}}"
                                               Foreground="#FFE8564A" FontSize="9" Margin="0,0,3,0"/>
                                        <Polygon Points="0,0 6,0 3,6" Fill="#FFE8564A"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>
