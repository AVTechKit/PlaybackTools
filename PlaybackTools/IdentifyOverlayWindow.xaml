<Window x:Class="PlaybackTools.IdentifyOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="Manual"
        Background="Transparent" AllowsTransparency="True" Topmost="True"
        ShowInTaskbar="False" Focusable="False">
    <Border Background="#CC000000" CornerRadius="16" Width="220" Height="220"
            HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock x:Name="NumberText" Foreground="White" FontSize="120" FontWeight="Bold"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
</Window>