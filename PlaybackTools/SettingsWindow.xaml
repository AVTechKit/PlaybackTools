<Window x:Class="PlaybackTools.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:vm="clr-namespace:PlaybackTools.ViewModels"
        Title="Settings" Height="675" Width="420" WindowStartupLocation="CenterOwner"
        Background="#FF1E1E1E" ResizeMode="NoResize">
    <Window.Resources>

        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF3A9EDB"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="SettingsButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF2A2A2A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF3A3A3A"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>

        <Style x:Key="SettingsLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="18">

            <!-- SHOW FILE SECTION -->
            <TextBlock Text="SHOW FILE" Style="{StaticResource SectionHeaderStyle}"/>
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="New Show" Margin="0,0,4,0"
                        Style="{StaticResource SettingsButtonStyle}" Click="NewShowButton_Click"/>
                <Button Grid.Column="1" Content="Save Show" Margin="4,0"
                        Style="{StaticResource SettingsButtonStyle}" Click="SaveShowButton_Click"/>
                <Button Grid.Column="2" Content="Load Show" Margin="4,0,0,0"
                        Style="{StaticResource SettingsButtonStyle}" Click="LoadShowButton_Click"/>
            </Grid>

            <!-- DEVICE SETTINGS SECTION -->
            <TextBlock Text="DEVICE SETTINGS" Style="{StaticResource SectionHeaderStyle}"/>
            <StackPanel Margin="0,0,0,24">
                <TextBlock Text="Playback Display:" Style="{StaticResource SettingsLabelStyle}"/>
                <DockPanel Margin="0,0,0,16">
                    <Button x:Name="IdentifyButton" DockPanel.Dock="Right" Content="Identify" Width="70" Margin="6,0,0,0"
                            Style="{StaticResource SettingsButtonStyle}" Click="IdentifyButton_Click"
                            ToolTip="Briefly show each display's number on screen"/>
                    <ComboBox x:Name="DisplayComboBox"/>
                </DockPanel>

                <TextBlock Text="Audio Output Device:" Style="{StaticResource SettingsLabelStyle}"/>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="&#8635;" Width="32" Margin="6,0,0,0"
                            Style="{StaticResource SettingsButtonStyle}" Click="RefreshAudioDevicesButton_Click"
                            ToolTip="Refresh audio device list"/>
                    <ComboBox x:Name="AudioDeviceComboBox"/>
                </DockPanel>
            </StackPanel>

            <!-- PLAYBACK SETTINGS SECTION -->
            <TextBlock Text="PLAYBACK SETTINGS" Style="{StaticResource SectionHeaderStyle}"/>
            <StackPanel Margin="0,0,0,24">
                <TextBlock Text="Default End Action:" Style="{StaticResource SettingsLabelStyle}"/>
                <ComboBox x:Name="DefaultEndActionComboBox"/>
                <Button Content="Background Image" Style="{StaticResource SettingsButtonStyle}" Margin="0,12,0,0"
                        Click="BackgroundImageButton_Click"/>
                
            </StackPanel>

            <!-- APPLICATION SECTION -->
            <TextBlock Text="APPLICATION" Style="{StaticResource SectionHeaderStyle}"/>
            <StackPanel Margin="0,0,0,10">
                <TextBlock x:Name="VersionTextBlock" Foreground="#FFAAAAAA" Margin="0,0,0,12"/>
                <Button Content="Quick Start Guide" Style="{StaticResource SettingsButtonStyle}" Margin="0,0,0,8"
                        Click="QuickStartGuideButton_Click"/>
                <Button Content="Licenses" Style="{StaticResource SettingsButtonStyle}" Margin="0,0,0,8"
                        Click="LicensesButton_Click"/>
                <Button Content="Quit PlaybackTools" Background="#FF8B0000" Foreground="White"
                        BorderBrush="#FF3A3A3A" Padding="8,6" Click="QuitButton_Click"/>
                
            </StackPanel>

            <!-- APPLY -->
            <Button Content="Apply" Width="100" HorizontalAlignment="Right" Margin="0,14,0,0"
                    Background="#FF1E5F8A" Foreground="White" Padding="8,6" Click="ApplyButton_Click"/>

        </StackPanel>
    </ScrollViewer>
</Window>