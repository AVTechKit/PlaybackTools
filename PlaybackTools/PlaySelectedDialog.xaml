<Window x:Class="PlaybackTools.PlaySelectedDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Play Selected Clip" Height="220" Width="380" WindowStartupLocation="CenterOwner"
        Background="#FF1E1E1E" ResizeMode="NoResize">
    <StackPanel Margin="15">
        <TextBlock Text="Page:" Foreground="White" Margin="0,0,0,4"/>
        <ComboBox x:Name="PageComboBox" SelectionChanged="PageComboBox_SelectionChanged" Margin="0,0,0,12"/>

        <TextBlock Text="Clip:" Foreground="White" Margin="0,0,0,4"/>
        <ComboBox x:Name="ClipComboBox" SelectionChanged="ClipComboBox_SelectionChanged"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancel" Width="80" Margin="0,0,8,0" IsCancel="True"/>
            <Button x:Name="OkButton" Content="OK" Width="80" IsDefault="True" Click="OkButton_Click" IsEnabled="False"/>
        </StackPanel>
    </StackPanel>
</Window>
