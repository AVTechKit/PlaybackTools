<Window x:Class="PlaybackTools.DisplayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:glWpfControl="clr-namespace:OpenTK.Wpf;assembly=GLWpfControl"
        Title="Playback Tools - Display"
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="Manual"
        Background="Black" Cursor="None" Topmost="True" ShowInTaskbar="False">
    <Grid>
        <glWpfControl:GLWpfControl x:Name="GlViewA" Render="GlViewA_Render" Opacity="1"/>
        <glWpfControl:GLWpfControl x:Name="GlViewB" Render="GlViewB_Render" Opacity="0"/>
        <Image x:Name="BackgroundImage" Stretch="Uniform" Visibility="Collapsed"/>
    </Grid>
</Window>
