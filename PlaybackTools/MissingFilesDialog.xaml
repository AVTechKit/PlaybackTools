<Window x:Class="PlaybackTools.MissingFilesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Missing Files" Height="420" Width="560" WindowStartupLocation="CenterOwner"
        Background="#FF1E1E1E" ResizeMode="CanResizeWithGrip">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Foreground="White" TextWrapping="Wrap" Margin="0,0,0,10"
                   Text="The following clip files could not be found and were left empty - reload them manually once available."/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="FileListTextBlock" Foreground="#FFE8564A" TextWrapping="Wrap" FontFamily="Consolas"/>
        </ScrollViewer>

        <Button Grid.Row="2" Content="Close" Width="90" HorizontalAlignment="Right" Margin="0,12,0,0"
                Background="#FF2A2A2A" Foreground="White" BorderBrush="#FF3A3A3A" Padding="8,6"
                Click="CloseButton_Click"/>
    </Grid>
</Window>